   "link": null,
   "locked": false,
   "text": "Create a Supabase project\nCreate a Twilio account, join the WhatsApp\nsandbox on 2 to 3 phones\nPut the keys in prototype/.env.local\nRun vercel login once\nPause OneDrive sync during npm install\nRe-join the sandbox on recording morning (it\nexpires in 3 days)",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Create a Supabase project\nCreate a Twilio account, join the WhatsApp\nsandbox on 2 to 3 phones\nPut the keys in prototype/.env.local\nRun vercel login once\nPause OneDrive sync during npm install\nRe-join the sandbox on recording morning (it\nexpires in 3 days)",
   "autoResize": true,
   "lineHeight": 1.25
  },
