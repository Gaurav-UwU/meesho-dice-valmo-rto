  {
   "id": "e0073",
   "type": "text",
   "x": 74,
   "y": 1421.75,
   "width": 755.4032812500001,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#333",
   "backgroundColor": "transparent",
