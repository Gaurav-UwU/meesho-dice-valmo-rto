   "boundElements": [],
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "In-memory store; browser tabs stay in sync through BroadcastChannel. No accounts, no internet needed. The engine runs in the\nbrowser. The public link opens here. WhatsApp is the on-screen phone (/customer) and OTPs show on it.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "In-memory store; browser tabs stay in sync through BroadcastChannel. No accounts, no internet needed. The engine runs in the\nbrowser. The public link opens here. WhatsApp is the on-screen phone (/customer) and OTPs show on it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
