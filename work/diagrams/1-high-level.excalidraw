   "version": 1,
   "versionNonce": 1241130074,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "data.gov.in pincode directory → data/pincodes-<hub>.json\nOSRM road distances (cached, one request a second) → data/distances-<hub>.json\nCase data pack constants: 80% COD, RTO 20% / 5%, ₹50 forward / ₹120 reverse\nOSM map tiles load at runtime.  4 hubs: Powai (MH), Whitefield (KA), Lucknow (UP, Router hub), Gaya (BR)",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "data.gov.in pincode directory → data/pincodes-<hub>.json\nOSRM road distances (cached, one request a second) → data/distances-<hub>.json\nCase data pack constants: 80% COD, RTO 20% / 5%, ₹50 forward / ₹120 reverse\nOSM map tiles load at runtime.  4 hubs: Powai (MH), Whitefield (KA), Lucknow (UP, Router hub), Gaya (BR)",
   "autoResize": true,
   "lineHeight": 1.25
  },
