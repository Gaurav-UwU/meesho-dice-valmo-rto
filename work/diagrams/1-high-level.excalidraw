  {
   "id": "e0025",
   "type": "text",
   "x": 74,
   "y": 539.5,
   "width": 1637.1000000000001,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#dfe3f5",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
