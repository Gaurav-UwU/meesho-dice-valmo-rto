   "boundElements": [],
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "Postgres + Realtime. Browsers read with the anon key under read-only RLS; every write goes through /api with the service key\n(server only). Real WhatsApp on team phones and real OTPs. Used for the 90-second video.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Postgres + Realtime. Browsers read with the anon key under read-only RLS; every write goes through /api with the service key\n(server only). Real WhatsApp on team phones and real OTPs. Used for the 90-second video.",
   "autoResize": true,
   "lineHeight": 1.25
  },
