   "link": null,
   "locked": false,
   "text": "What keeps everything in sync",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "What keeps everything in sync",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e0116",
   "type": "text",
   "x": 34,
   "y": 2810.75,
   "width": 1080.7,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#333",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "g6"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 115948851,
   "version": 1,
   "versionNonce": 980634927,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "One shared store is the single source of truth. Screens never talk to each other; each one writes to the store and subscribes to it.\nDemo mode: in-memory store, browser tabs sync through BroadcastChannel. Live mode: Supabase Postgres + Realtime; writes only through /api, so keys\nand OTP checks stay on the server.\nTarget: a tap on the rider's phone shows on the ops laptop in under 2 seconds.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "One shared store is the single source of truth. Screens never talk to each other; each one writes to the store and subscribes to it.\nDemo mode: in-memory store, browser tabs sync through BroadcastChannel. Live mode: Supabase Postgres + Realtime; writes only through /api, so keys\nand OTP checks stay on the server.\nTarget: a tap on the rider's phone shows on the ops laptop in under 2 seconds.",
   "autoResize": true,
   "lineHeight": 1.25
  },
