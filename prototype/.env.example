# Copy to .env.local (local) and add the same names in Vercel > Settings > Environment Variables.
# NEVER commit real values. Claude does not create these; you do.

# Supabase (Project settings > API). The service key is secret: server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
# Public, read-only key used by the browser (safe: the table is read-only under RLS).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Generate strong random values, e.g. `openssl rand -hex 32` (OTP_PEPPER needs 32+ characters, ADMIN_TOKEN 12+, LIVE_KEY and CAPTAIN_KEY 20+ and different from each other).
# OTP_PEPPER protects the stored OTP hashes; make it long and random, never a word.
OTP_PEPPER=
ADMIN_TOKEN=
# Required: every browser call to /api/action must send it. Screens ask for it once per tab.
# The RIDER key: the phone QR codes carry it. It can only deliver, attempt, refuse and enter an OTP.
LIVE_KEY=
# The CAPTAIN key: the team's own, never in a QR code. Needed for the captain, desk, clock and pilot buttons.
CAPTAIN_KEY=

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX
# The exact public URL you paste into the sandbox "When a message comes in" box
TWILIO_WEBHOOK_URL=https://YOUR-APP.vercel.app/api/whatsapp
